{
  "name": "migration-dynamic-workflow",
  "version": "0.1.0",
  "private": true,
  "description": "An incremental Copilot dynamic workflow for legacy resource migrations",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test \"tests/*.test.mjs\"",
    "check": "npm run typecheck && npm test && node scripts/check-docs.mjs",
    "inspect": "node .github/extensions/resource-migration/cli.mjs inspect",
    "initialize": "node .github/extensions/resource-migration/cli.mjs initialize",
    "predemo": "npm run build",
    "demo": "node scripts/demo.mjs"
  },
  "devDependencies": {
    "@github/copilot-sdk": "1.0.19",
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
